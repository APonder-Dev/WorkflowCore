# Root environment reference for local development. Individual apps/packages
# may also have their own .env.example (see packages/database/.env.example).
# Copy to .env and fill in real values; never commit a populated .env file.

DATABASE_URL="postgresql://workflowcore:workflowcore@localhost:5432/workflowcore?schema=public"
REDIS_URL="redis://localhost:6379"
NATS_URL="nats://localhost:4222"

CONTROL_PLANE_PORT=3000

# Master key for credential encryption at rest. Generated in Phase 10
