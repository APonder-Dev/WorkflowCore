{
  "name": "workflowcore",
  "private": true,
  "version": "0.1.0",
  "description": "Event-driven workflow automation engine",
  "license": "MIT",
  "author": "Anthony Ponder <APonder-Dev>",
  "homepage": "https://github.com/APonder-Dev/WorkflowCore",
  "repository": {
    "type": "git",
    "url": "https://github.com/APonder-Dev/WorkflowCore.git"
  },
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.19.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.2.0",
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.18"
    }
  }
}
